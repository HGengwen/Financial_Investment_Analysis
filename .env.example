# 阿里云百炼 API Key
# 开通地址: https://bailian.console.aliyun.com/cn-beijing?tab=mcp#/mcp-market/detail/WebSearch
DASHSCOPE_API_KEY=your_api_key_here

# WebSearch MCP 服务端点 (SSE协议)
# 默认值: https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
WebSearch_MCP_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse

# Tavily MCP 服务端点 (默认值如下，通常无需修改)
Tavily_MCP_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/tavily-ai/sse

# Exa 搜索 API Key (申请地址: https://dashboard.exa.ai/api-keys)
# 免费层：每月 1000 次搜索额度
EXA_API_KEY=your_api_key_here

# 火山引擎AK/SK
VOLC_AK="your_ak_here"
VOLC_SK="your_sk_here"

# QPS 限流配置（账号维度默认 5 QPS，可提工单扩容）
VOLC_QPS=5