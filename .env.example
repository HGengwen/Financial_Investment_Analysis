# 阿里云百炼 API Key
# 开通地址: https://bailian.console.aliyun.com/cn-beijing?tab=mcp#/mcp-market/detail/WebSearch
DASHSCOPE_API_KEY=your_api_key_here

# WebSearch MCP 服务端点 (SSE协议)
# 默认值: https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
WebSearch_MCP_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse

# Tavily MCP 服务端点 (默认值如下，通常无需修改)
Tavily_MCP_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/tavily-ai/sse

# Exa 搜索 API Key (申请地址: https://dashboard.exa.ai/api-keys)
# 免费层：每月 1000 次搜索额度
EXA_API_KEY=your_api_key_here

# 火山引擎AK/SK
VOLC_AK="your_ak_here"
VOLC_SK="your_sk_here"

# QPS 限流配置（账号维度默认 5 QPS，可提工单扩容）
VOLC_QPS=5

# 汇率获取最大记录数硬上限（默认 50 条）
FX_MAX_RECORDS_HARD_LIMIT=50

# a_stock_cache.py A股本地缓存配置（tools/common/a_stock_cache.py）
# STOCK_CACHE_TTL_DAYS: 缓存有效期（天），默认 7 天
#   - 到期后任意查询会触发一次全量刷新（含退市/改名股自愈）
#   - 行业数据按季度刷新，季度数据天然适合缓存
STOCK_CACHE_TTL_DAYS=30

# 港股/美股本地缓存配置（tools/common/hk_stock_cache.py, tools/common/us_stock_cache.py）
# STOCK_CACHE_TTL_DAYS 同时用于港股/美股代码列表缓存有效期（默认 7 天，此处沿用 A 股配置 30 天）
US_STOCK_INFO_TTL_DAYS=1
#   - US_STOCK_INFO_TTL_DAYS: 美股慢变字段缓存有效期（天），默认 1 天
#   - yfinance 实时接口失败（限流 429/断连）时，从本地慢变字段缓存降级返回估值指标
# US_TICKER_MIRROR_URLS: 美股列表自定义镜像 URL（逗号分隔，可选）
#   - 官网 nasdaqtrader.com 与 NASDAQ API 均不可达时尝试镜像
#   - 镜像格式与 nasdaqlisted.txt 相同管道分隔，或与 NASDAQ API 相同 JSON
US_TICKER_MIRROR_URLS=

# 三市场财务数据本地缓存 TTL（tools/common/a_stock_cache.py, hk_stock_cache.py, us_stock_cache.py）
# 财务数据（指标/报表）变化节奏慢，缓存 TTL 通常与季报披露节奏匹配（默认 7 天）
# A_FINANCIAL_TTL_DAYS:   A 股财务摘要 / 利润表缓存有效期（天），默认 7 天
# A_IPO_TTL_DAYS:         A 股 IPO 信息缓存有效期（天），默认 90 天（上市后几乎不变，长 TTL 仅作自愈兜底）
# HK_FINANCIAL_TTL_DAYS:  港股财务指标 / 财务报表缓存有效期（天），默认 7 天
# US_FINANCIAL_TTL_DAYS:  美股三大报表缓存有效期（天），默认 7 天
# US_DIVIDENDS_TTL_DAYS:  美股分红 / 拆股历史缓存有效期（天），默认 30 天（历史数据几乎不变）
A_FINANCIAL_TTL_DAYS=7
A_IPO_TTL_DAYS=90
HK_FINANCIAL_TTL_DAYS=7
US_FINANCIAL_TTL_DAYS=7
US_DIVIDENDS_TTL_DAYS=30

# AnySearch 搜索工具配置
# API Key 申请: https://anysearch.com/console/api-keys
# 注册免费账号可获每日 1000 次额度，学生/开源认证 2000 次/日
# 不填则匿名调用（额度极少，仅临时测试）
ANYSEARCH_API_KEY=your_api_key_here
ANYSEARCH_BASE_URL=https://api.anysearch.com
# QPS 限流（客户端限制，避免突发流量触发 429）
ANYSEARCH_MAX_QPS=20
# 默认搜索参数
ANYSEARCH_DEFAULT_MAX_RESULTS=10
ANYSEARCH_DEFAULT_ZONE=cn
ANYSEARCH_DEFAULT_LANGUAGE=zh-CN
ANYSEARCH_DEFAULT_FORMAT=json
# 请求超时（秒）
ANYSEARCH_REQUEST_TIMEOUT=30